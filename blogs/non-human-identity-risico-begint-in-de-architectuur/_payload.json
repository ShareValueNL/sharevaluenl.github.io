1.13,392,21130,{"ext":23,"url":122,"hash":123,"mime":26,"name":124,"path":18,"size":125,"width":52,"height":126,"sizeInBytes":127},"https://incredible-beef-2a6059b946.media.strapiapp.com/thumbnail_OP_Afb_Blog_non_human_identity_risico_e31c45cc09.webp","thumbnail_OP_Afb_Blog_non_human_identity_risico_e31c45cc09","thumbnail_OP Afb Blog non-human identity-risico.jpg",5.28,128,5282,"OP_Afb_Blog_non_human_identity_risico_e31c45cc09",51.27,"https://incredible-beef-2a6059b946.media.strapiapp.com/OP_Afb_Blog_non_human_identity_risico_e31c45cc09.webp","2026-08-25T12:34:57.328Z","pctqgd1dc4vs2xlfx64rdgu9","2026-08-25T12:34:57.329Z",[],[136],{"id":137,"title":91,"subTitle":138,"description":139,"shortDescription":140,"slug":141,"createdAt":142,"updatedAt":143,"publishedAt":144,"isCoreExpertise":145,"documentId":146,"image":147,"seo":167,"blocks":182,"midPageBlocks":222},1,"Hét cloudcomputing platform van Microsoft","Azure is het cloudcomputing platform van Microsoft, dat zowel Infrastructure as a Service (IaaS) als Platform as a Service (PaaS) biedt. Met dit platform kun je applicaties ontwikkelen of een compleet netwerk hosten, en dit alles op een relatief eenvoudige manier beheren. Omdat Azure wordt gehost in managed datacenters over de hele wereld, kun je jouw netwerk of applicatie wereldwijd beschikbaar maken. Microsoft biedt daarnaast een breed scala aan services, zoals Internet of Things (IoT), Azure Kubernetes, Artificial Intelligence (AI) en oplossingen voor het gebruik van Big Data.\n\nOnze Azure consultants, engineers en cloud-architecten hebben ervaring met de ontwikkeling, implementatie en het beheer van de verschillende mogelijkheden die Microsoft Azure ons biedt. Hierbij leveren wij iedere keer maatwerk, want het programma van eisen ziet er telkens anders uit. Of het nu gaat om de ondersteuning van een Azure team of het volledige beheer, onze Azure experts staan voor je klaar. Meer over ons werk lees je onder andere in onze Azure [klantcases](/kennisbank/klantcases/azure) en [blogs](/kennisbank/blogs/azure).\n\n","Onze Azure consultants, engineers en cloud-architecten hebben ervaring met de ontwikkeling, implementatie en het beheer van de verschillende mogelijkheden die Microsoft Azure ons biedt.","azure","2023-08-17T09:47:20.996Z","2025-04-11T13:11:55.618Z","2023-08-17T09:50:22.095Z",true,"eubwn704tlyata6v2q819fn7",{"id":148,"name":149,"alternativeText":18,"caption":18,"width":150,"height":151,"formats":152,"hash":161,"ext":154,"mime":157,"size":162,"url":163,"previewUrl":18,"provider":58,"provider_metadata":18,"createdAt":164,"updatedAt":164,"documentId":165,"publishedAt":166,"focalPoint":18},657,"mircosoft azure web.png",282,130,{"thumbnail":153},{"ext":154,"url":155,"hash":156,"mime":157,"name":158,"path":18,"size":159,"width":52,"height":160},".png","https://incredible-beef-2a6059b946.media.strapiapp.com/thumbnail_mircosoft_azure_web_031897ebac.png","thumbnail_mircosoft_azure_web_031897ebac","image/png","thumbnail_mircosoft azure web.png",5.54,113,"mircosoft_azure_web_031897ebac",1.49,"https://incredible-beef-2a6059b946.media.strapiapp.com/mircosoft_azure_web_031897ebac.png","2024-04-05T12:52:48.184Z","z9c21qscgi7eh5jijkc40fzv","2026-01-05T12:38:34.018Z",{"id":168,"metaTitle":169,"metaDescription":170,"structuredData":171,"metaImage":18,"metaSocial":181},24,"Microsoft Azure-expertise – ShareValue helpt je vooruit","Van beheer tot DevOps: onze Azure-specialisten helpen je om cloudoplossingen slim en veilig in te richten en te optimaliseren.",{"url":172,"@type":173,"@context":78,"provider":174,"areaServed":176,"description":179,"serviceType":180},"https://www.sharevalue.nl/wat-we-doen/azure","Service",{"url":175,"name":76,"@type":77},"https://www.sharevalue.nl",{"name":177,"@type":178},"Nederland","Country","ShareValue helpt organisaties om Microsoft Azure effectief in te zetten. Onze specialisten werken aan cloudmigraties, infrastructuur, security, automation en DevOps-oplossingen.","Microsoft Azure consultancy",[],[183,191],{"id":184,"title":185,"aside":18,"postType":186,"limit":187,"expertise":188,"__component":190},165,"Lees meer over Azure","alle",3,[189],{"id":137,"title":91,"subTitle":138,"description":139,"shortDescription":140,"slug":141,"createdAt":142,"updatedAt":143,"publishedAt":144,"isCoreExpertise":145,"documentId":146},"strapi.related-kennisbank-list",{"id":192,"titleLeft":193,"callToActionTextLeft":194,"callToActionLinkUrlLeft":195,"titleRight":196,"callToActionTextRight":197,"callToActionLinkUrlRight":198,"iconUrlLeft":199,"iconUrlRight":212,"__component":221},209,"Heb je een Azure expert nodig?","Neem contact met ons op","/contact","Zoek je een nieuwe baan?","Bekijk onze vacatures","/word-onze-collega/vacatures",{"id":200,"name":201,"alternativeText":18,"caption":18,"width":202,"height":203,"formats":18,"hash":204,"ext":205,"mime":206,"size":207,"url":208,"previewUrl":18,"provider":58,"provider_metadata":18,"createdAt":209,"updatedAt":210,"documentId":211,"publishedAt":166,"focalPoint":18},6,"bulb.svg",71,70,"bulb_dd2e1d4efb",".svg","image/svg+xml",3.75,"https://incredible-beef-2a6059b946.media.strapiapp.com/bulb_dd2e1d4efb.svg","2023-08-17T08:31:37.036Z","2025-04-01T14:08:08.648Z","l2lglwkh4lf7ip36sjvs42rc",{"id":213,"name":214,"alternativeText":18,"caption":18,"width":203,"height":203,"formats":18,"hash":215,"ext":205,"mime":206,"size":216,"url":217,"previewUrl":18,"provider":58,"provider_metadata":18,"createdAt":218,"updatedAt":219,"documentId":220,"publishedAt":166,"focalPoint":18},8,"briefcase.svg","briefcase_679abae475",4.49,"https://incredible-beef-2a6059b946.media.strapiapp.com/briefcase_679abae475.svg","2023-08-17T08:31:37.038Z","2025-01-24T15:53:51.531Z","bfdftlvwhj35dm37dzv4aujf","call-to-action.double",[223,268,302,334],{"id":224,"title":225,"subTitle":18,"content":226,"callToActionText":227,"callToActionLink":195,"colorStyle":228,"showAsides":229,"imageUrl":230,"__component":267},25,"Azure Security: veiligheid in de cloud ","Voor organisaties is het belangrijk om de digitale infrastructuur te beveiligen in een steeds complexer wordend cyberlandschap. Onze experts helpen graag met behulp van Azure Security; een reeks beveiligingsdiensten en -functies die door Microsoft Azure wordt aangeboden om bedreigingen te detecteren, te voorkomen en erop te reageren. Enkele belangrijke componenten en functies van Azure Security waarmee wij werken zijn Azure Security Center, Microsoft Entra ID, Azure DDoS Protection en Azure Sentinel.","Neem contact op voor meer informatie","Sugar Glaze",false,{"id":231,"name":232,"alternativeText":18,"caption":18,"width":19,"height":233,"formats":234,"hash":262,"ext":236,"mime":239,"size":263,"url":264,"previewUrl":18,"provider":58,"provider_metadata":18,"createdAt":265,"updatedAt":265,"documentId":266,"publishedAt":166,"focalPoint":18},779,"security azure.jpg",850,{"large":235,"small":243,"medium":249,"thumbnail":255},{"ext":236,"url":237,"hash":238,"mime":239,"name":240,"path":18,"size":241,"width":29,"height":242},".jpg","https://incredible-beef-2a6059b946.media.strapiapp.com/large_security_azure_b1610cf1cb.jpg","large_security_azure_b1610cf1cb","image/jpeg","large_security azure.jpg",107.3,664,{"ext":236,"url":244,"hash":245,"mime":239,"name":246,"path":18,"size":247,"width":20,"height":248},"https://incredible-beef-2a6059b946.media.strapiapp.com/small_security_azure_b1610cf1cb.jpg","small_security_azure_b1610cf1cb","small_security azure.jpg",39.16,332,{"ext":236,"url":250,"hash":251,"mime":239,"name":252,"path":18,"size":253,"width":44,"height":254},"https://incredible-beef-2a6059b946.media.strapiapp.com/medium_security_azure_b1610cf1cb.jpg","medium_security_azure_b1610cf1cb","medium_security azure.jpg",71.35,498,{"ext":236,"url":256,"hash":257,"mime":239,"name":258,"path":18,"size":259,"width":260,"height":261},"https://incredible-beef-2a6059b946.media.strapiapp.com/thumbnail_security_azure_b1610cf1cb.jpg","thumbnail_security_azure_b1610cf1cb","thumbnail_security azure.jpg",12.37,235,156,"security_azure_b1610cf1cb",150.42,"https://incredible-beef-2a6059b946.media.strapiapp.com/security_azure_b1610cf1cb.jpg","2024-08-08T08:50:26.921Z","z3xlbivuior2upad6adbxjgz","global.alternating-page-section",{"id":269,"title":270,"subTitle":18,"content":271,"callToActionText":18,"callToActionLink":18,"colorStyle":272,"showAsides":229,"imageUrl":273,"__component":267},26,"Azure Kubernetes Service (AKS)","Azure Kubernetes Service (AKS) helpt bij het beheren van applicaties die in containers draaien. Het vereenvoudigt en automatiseert de implementatie, het beheer en de operationele taken van Kubernetes-clusters. Door gebruik te maken van AKS kunnen organisaties zich richten op het ontwikkelen en beheren van hun applicaties, terwijl Microsoft de complexiteit van de Kubernetes-infrastructuur beheert. Hierdoor kunnen organisaties hun software efficiënt, betrouwbaar en kosteneffectief beheren. Doordat onze experts ruime kennis en ervaring hebben met AKS kunnen ze de klanten op een juiste manier helpen.","White",{"id":274,"name":275,"alternativeText":18,"caption":18,"width":19,"height":233,"formats":276,"hash":297,"ext":236,"mime":239,"size":298,"url":299,"previewUrl":18,"provider":58,"provider_metadata":18,"createdAt":300,"updatedAt":300,"documentId":301,"publishedAt":166,"focalPoint":18},780,"containers.jpg",{"large":277,"small":282,"medium":287,"thumbnail":292},{"ext":236,"url":278,"hash":279,"mime":239,"name":280,"path":18,"size":281,"width":29,"height":242},"https://incredible-beef-2a6059b946.media.strapiapp.com/large_containers_2e766510ad.jpg","large_containers_2e766510ad","large_containers.jpg",163.19,{"ext":236,"url":283,"hash":284,"mime":239,"name":285,"path":18,"size":286,"width":20,"height":248},"https://incredible-beef-2a6059b946.media.strapiapp.com/small_containers_2e766510ad.jpg","small_containers_2e766510ad","small_containers.jpg",49.69,{"ext":236,"url":288,"hash":289,"mime":239,"name":290,"path":18,"size":291,"width":44,"height":254},"https://incredibl