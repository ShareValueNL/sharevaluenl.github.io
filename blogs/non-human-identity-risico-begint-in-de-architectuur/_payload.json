ishedAt":166,"focalPoint":18},{"large":394,"small":395,"medium":396,"thumbnail":397},{"ext":236,"url":278,"hash":279,"mime":239,"name":280,"path":18,"size":281,"width":29,"height":242},{"ext":236,"url":283,"hash":284,"mime":239,"name":285,"path":18,"size":286,"width":20,"height":248},{"ext":236,"url":288,"hash":289,"mime":239,"name":290,"path":18,"size":291,"width":44,"height":254},{"ext":236,"url":293,"hash":294,"mime":239,"name":295,"path":18,"size":296,"width":260,"height":261},{"id":168,"title":303,"subTitle":18,"content":304,"callToActionText":18,"callToActionLink":18,"colorStyle":228,"showAsides":229,"imageUrl":399,"__component":267},{"id":306,"name":307,"alternativeText":18,"caption":18,"width":19,"height":233,"formats":400,"hash":329,"ext":236,"mime":239,"size":330,"url":331,"previewUrl":18,"provider":58,"provider_metadata":18,"createdAt":332,"updatedAt":332,"documentId":333,"publishedAt":166,"focalPoint":18},{"large":401,"small":402,"medium":403,"thumbnail":404},{"ext":236,"url":310,"hash":311,"mime":239,"name":312,"path":18,"size":313,"width":29,"height":242},{"ext":236,"url":315,"hash":316,"mime":239,"name":317,"path":18,"size":318,"width":20,"height":248},{"ext":236,"url":320,"hash":321,"mime":239,"name":322,"path":18,"size":323,"width":44,"height":254},{"ext":236,"url":325,"hash":326,"mime":239,"name":327,"path":18,"size":328,"width":260,"height":261},{"id":335,"title":336,"callToActionText":337,"callToActionLinkUrl":338,"body":18,"imageUrl":406,"__component":340},{"id":200,"name":201,"alternativeText":18,"caption":18,"width":202,"height":203,"formats":18,"hash":204,"ext":205,"mime":206,"size":207,"url":208,"previewUrl":18,"provider":58,"provider_metadata":18,"createdAt":209,"updatedAt":210,"documentId":211,"publishedAt":166,"focalPoint":18},{"id":408,"title":409,"subTitle":409,"description":410,"shortDescription":410,"slug":411,"createdAt":412,"updatedAt":413,"publishedAt":414,"isCoreExpertise":229,"documentId":415,"image":416,"seo":18,"blocks":445,"midPageBlocks":446},9,"Architect","\"","architect","2023-11-10T07:52:25.259Z","2023-11-10T07:53:22.170Z","2023-11-10T07:53:22.058Z","x9hq3mqhktltw90g0k4ina0y",{"id":417,"name":418,"alternativeText":18,"caption":18,"width":19,"height":20,"formats":419,"hash":440,"ext":236,"mime":239,"size":441,"url":442,"previewUrl":18,"provider":58,"provider_metadata":18,"createdAt":443,"updatedAt":443,"documentId":444,"publishedAt":166,"focalPoint":18},143,"pooltafel.jpg",{"large":420,"small":425,"medium":430,"thumbnail":435},{"ext":236,"url":421,"hash":422,"mime":239,"name":423,"path":18,"size":424,"width":29,"height":30},"https://incredible-beef-2a6059b946.media.strapiapp.com/large_pooltafel_737db83b07.jpg","large_pooltafel_737db83b07","large_pooltafel.jpg",76.89,{"ext":236,"url":426,"hash":427,"mime":239,"name":428,"path":18,"size":429,"width":20,"height":37},"https://incredible-beef-2a6059b946.media.strapiapp.com/small_pooltafel_737db83b07.jpg","small_pooltafel_737db83b07","small_pooltafel.jpg",26.21,{"ext":236,"url":431,"hash":432,"mime":239,"name":433,"path":18,"size":434,"width":44,"height":45},"https://incredible-beef-2a6059b946.media.strapiapp.com/medium_pooltafel_737db83b07.jpg","medium_pooltafel_737db83b07","medium_pooltafel.jpg",49.65,{"ext":236,"url":436,"hash":437,"mime":239,"name":438,"path":18,"size":439,"width":52,"height":53},"https://incredible-beef-2a6059b946.media.strapiapp.com/thumbnail_pooltafel_737db83b07.jpg","thumbnail_pooltafel_737db83b07","thumbnail_pooltafel.jpg",7.77,"pooltafel_737db83b07",112.02,"https://incredible-beef-2a6059b946.media.strapiapp.com/pooltafel_737db83b07.jpg","2023-08-24T10:51:19.397Z","ffge4u003fjgklicm2rua4zz",[],[],[448,452,455,458,461,464,467,470,473,476,479,483,501],{"id":449,"title":18,"asideText":18,"underline":229,"centered":229,"blankAside":229,"aside":18,"content":450,"introductionText":18,"__component":451},5429,"_* Lees [hier de eerste](https://sharevalue.nl/blogs/de-blinde-vlek-in-zero-trust-identiteiten-zonder-mens) en [hier de tweede blog](https://sharevalue.nl/blogs/waarom-zero-trust-faalt-zonder-grip-op-non-human-identities) terug._\n\n## Architectuur creëert identiteiten, niet beleid\n\nNon-human identities ontstaan zelden vanuit een bewuste keuze om een nieuwe identiteit toe te voegen. Meestal zijn ze een bijproduct van architectuur. Elke moderne cloudarchitectuur optimaliseert voor: \n- Snelheid: ontwikkelteams moeten snel kunnen bouwen, testen en uitrollen zonder handmatige tussenstappen.\n- Schaal: architecturen moeten automatisch kunnen meegroeien met gebruik, data en workloads.\n- Automatisering: handmatig beheer maakt plaats voor scripts, pipelines en platformlogica.\n- Herhaalbaarheid: omgevingen en deployments moeten consistent opnieuw kunnen worden opgebouwd. \n\nDeze eigenschappen leveren wendbaarheid op, maar hebben ook een keerzijde. Identiteiten ontstaan sneller dan ze worden begrepen, krijgen ruimere rechten dan noodzakelijk en blijven vaak bestaan nadat hun oorspronkelijke taak is veranderd of verdwenen. \nDat is niet alleen een governancevraagstuk. Het is een architectuurrealiteit. Als identiteit pas na het ontwerp wordt toegevoegd, loopt beheersing per definitie achter de feiten aan.\n\n![afbeelding 1.jpg](https://incredible-beef-2a6059b946.media.strapiapp.com/afbeelding_1_617d5c50d2.webp)","global.pagesection",{"id":453,"title":18,"asideText":18,"underline":229,"centered":229,"blankAside":229,"aside":18,"content":454,"introductionText":18,"__component":451},5430,"## Automatisering maakt tijdelijk vertrouwen structureel\n\nIn cloudomgevingen is automatisering geen optimalisatie meer, maar een voorwaarde.  \nResources worden: \n- Automatisch aangemaakt: Via templates, pipelines of platformservices, zonder menselijke tussenkomst.\n- Automatisch geconfigureerd: Instellingen en koppelingen worden door automatisering toegepast.\n- Automatisch gedeployed: Nieuwe versies worden continu uitgerold naar test- en productieomgevingen. \n \nElke automatiseringsstap introduceert een identiteit die: \n- Toegang nodig heeft om resources te lezen, wijzigen of aan te maken.\n- Bevoegdheden krijgt die vaak breder zijn dan strikt noodzakelijk, om fouten te voorkomen.\n- Daarna meestal blijft bestaan ook wanneer de oorspronkelijke taak of context verandert. \n \nWat begint als “tijdelijk voor de pipeline”, wordt vaak structureel. Niet omdat iemand dat zo wil, maar omdat architecturen zelden expliciet definiëren wanneer een identiteit mag verdwijnen.",{"id":456,"title":18,"asideText":18,"underline":229,"centered":229,"blankAside":229,"aside":18,"content":457,"introductionText":18,"__component":451},5431,"## CI/CD-pipelines: de meest vertrouwde identiteiten\n\nCI/CD pipelines zijn vaak de eerste plek waar non-human identity-risico zichtbaar wordt.\nZe moeten resources aanmaken (bijvoorbeeld infrastructuur, services of dependencies), configuraties wijzigen (inclusief netwerk-, security- en identity-instellingen) en code naar productie uitrollen zonder handmatige goedkeuring bij elke stap. Daardoor behoren pipeline-identiteiten vaak tot de krachtigste identiteiten in de omgeving.\n \nOm dit betrouwbaar te kunnen doen, krijgen ze brede rechten. En omdat deployments moeten blijven werken, worden die rechten zelden teruggedraaid.\nHet gevolg: pipelines met productie-toegang, identiteiten die meerdere omgevingen overstijgen en rechten die ouder zijn dan de applicatie zelf. Dit voelt praktisch. Maar architectonisch is het impliciet vertrouwen op schaal.\n\n![afbeelding 2.jpg](https://incredible-beef-2a6059b946.media.strapiapp.com/afbeelding_2_422c66dd31.webp)",{"id":459,"title":18,"asideText":18,"underline":229,"centered":229,"blankAside":229,"aside":18,"content":460,"introductionText":18,"__component":451},5432,"## Microservices en service-to-service vertrouwen\n\nCloud-native architecturen breken applicaties op in kleine, zelfstandige services.\n Elke service:\n- Communiceert met andere services voor data-uitwisseling en procesafhandeling.\n- Data opvraagt uit databases, queues of externe systemen.\n- Acties triggert elders zoals het starten van processen of het aanpassen van state.\n\nElke interactie vereist een identiteit. Wat vaak ontbreekt in het ontwerp:\n- Expliciete vertrouwensgrenzen tussen services.\n- Duidelijke scoping per afhankelijkheid.\n- Onderscheid tussen “mag praten” en “mag handelen”.\n \nHet resultaat is een netwerk van services dat functioneert, maar waarbij vertrouwen transitief wordt. En transitief vertrouwen is precies wat Zero Trust probeert te vermijden.",{"id":462,"title":18,"asideText":18,"underline":229,"centered":229,"blankAside":229,"aside":18,"content":463,"introductionText":18,"__component":451},5433,"## AI-workloads: identiteiten zonder pauzeknop\n\nAI-workloads versterken hetzelfde patroon. Ze draaien autonoom, halen continu data op, roepen andere services aan en kunnen vervolgacties starten. Er is geen duidelijk loginmoment en vaak ook geen natuurlijk afsluitmoment. De toegang blijft bestaan zolang de workload actief is.\n\nWat vaak wordt onderschat is hoe breed de toegang moet zijn om “flexibel” te blijven, hoe moeilijk het is om rechten te beperken zonder functionaliteit te breken en hoe weinig zicht er is op wat de workload daadwerkelijk gebruikt. AI-workloads maken non-human identities niet alleen talrijker, maar ook moeilijker af te bakenen.\n\n![afbeelding 3.jpg](https://incredible-beef-2a6059b946.media.strapiapp.com/afbeelding_3_49522fb99d.webp)",{"id":465,"title":18,"asideText":18,"underline":229,"centered":229,"blankAside":229,"aside":18,"content":466,"introductionText":18,"__component":451},5434,"## Omgevingen vervagen sneller dan verwacht\n\nIn theorie zijn ontwikkel-, test- en productieomgevingen strikt gescheiden. In de praktijk delen pipelines identiteiten tussen deze omgevingen, worden secrets hergebruikt omdat dit ‘tijdelijk’ of ‘praktisch’ is en worden tijdelijke uitzonderingen onder druk van deadlines en stabiliteit permanent. Niet uit nalatigheid, maar uit tijdsdruk.\n\nArchitecturen die deze uitzonderingen toestaan, creëren identiteiten die omgevingsoverstijgend vertrouwen krijgen. Zodra dat gebeurt, is de blast radius geen abstract concept meer.",{"id":468,"title":18,"asideText":18,"underline":229,"centered":229,"blankAside":229,"aside":18,"content":469,"introductionText":18,"__component":451},5435,"## Het patroon achter de voorbeelden\n\nDe rode draad is niet tooling en niet discipline. Het patroon is dit:\n- Architecturen worden ontworpen voor functionaliteit,\n- en identiteiten worden achteraf passend gemaakt. \n\nMaar identiteiten zijn geen bijzaak. Ze zijn het trust model. Zolang identiteiten ontstaan als afgeleide van architectuur, zal governance altijd achterlopen. ",{"id":471,"title":18,"asideText":18,"underline":229,"centered":229,"blankAside":229,"aside":18,"content":472,"introductionText":18,"__component":451},5436,"## Vier signalen die je nu al kunt herkennen\n\nNet als in de eerdere blogs is dit geen handleiding, maar er zijn wel signalen die je kunt zien:\n- Architectuurdiagrammen waarin identiteiten niet voorkomen\n- Pipelines met meer rechten dan individuele services\n- Workloads die meerdere omgevingen kunnen bereiken\n- AI-processen waarvan niemand precies weet welke toegang ze nodig hebben\n\nZijn deze patronen aanwezig, dan is het identiteitsrisico niet incidenteel. Het is structureel in de architectuur ingebouwd.",{"id":474,"title":18,"asideText":18,"underline":229,"centered":229,"blankAside":229,"aside":18,"content":475,"introductionText":18,"__component":451},5437,"## Vooruitblik: van architectuur naar operatie\n\nDe [eerste blog](https://sharevalue.nl/blogs/de-blinde-vlek-in-zero-trust-identiteiten-zonder-mens) liet zien welke identiteitslaag vaak wordt genegeerd. De [tweede blog](https://sharevalue.nl/blogs/waarom-zero-trust-faalt-zonder-grip-op-non-human-identities) maakte duidelijk waarom klassieke Zero Trust-aannames bij non-human identities tekortschieten. Deze derde blog toont waar het risico ontstaat: in architecturen die automatisering en functionaliteit centraal stellen, maar identiteit niet als zelfstandig ontwerpprincipe behandelen. \n\nDaarmee blijft één vraag over: hoe houd je grip in een omgeving die voortdurend verandert? In de vierde en laatste blog kijken we naar de operationele realiteit: eigenaarschap, lifecycle, monitoring en identity drift. Niet om architectuur te vertragen, maar om haar beheersbaar te maken.",{"id":477,"title":18,"showBlankAside":229,"__component":478},606,"global.social-sharing",{"id":480,"name":72,"jobTitle":481,"__component":482},483,"Azure Engineer & Architect","strapi.author-card",{"id":484,"titleLeft":485,"callToActionTextLeft":194,"callToActionLinkUrlLeft":195,"titleRight":486,"callToActionTextRight":487,"callToActionLinkUrlRight":488,"iconUrlLeft":489,"iconUrlRight":500,"__component":221},769,"Heb je een Azure Architect nodig?","Kom je werken in ons Azure-team?","Klik hier","/word-onze-collega",{"id":490,"name":491,"alternativeText":18,"caption":18,"width":492,"height":493,"formats":18,"hash":494,"ext":205,"mime":206,"size":495,"url":496,"previewUrl":18,"provider":58,"provider_metadata":18,"createdAt":497,"updatedAt":498,"documentId":499,"publishedAt":166,"focalPoint":18},372,"magnifier.svg",49,60,"magnifier_d084afba36",1.05,"https://incredible-beef-2a6059b946.media.strapiapp.com/magnifier_d084afba36.svg","2023-11-03T11:13:25.446Z","2026-05-12T12:19:53.518Z","e7czsfz9jg7oi93q44vomebz",{"id":213,"name":214,"alternativeText":18,"caption":18,"width":203,"height":203,"formats":18,"hash":215,"ext":205,"mime":206,"size":216,"url":217,"previewUrl":18,"provider":58,"provider_metadata":18,"createdAt":218,"updatedAt":219,"documentId":220,"publishedAt":166,"focalPoint":18},{"id":502,"title":185,"aside":18,"postType":503,"limit":187,"expertise":504,"__component":190},539,"blogs",[505],{"id":137,"title":91,"subTitle":138,"description":139,"shortDescription":140,"slug":141,"createdAt":142,"updatedAt":143,"publishedAt":14