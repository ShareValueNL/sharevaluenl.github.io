[{"data":1,"prerenderedAt":548},["ShallowReactive",2],{"collection-blogs-1953715490":3},{"data":4,"meta":545},[5],{"id":6,"title":7,"excerpt":8,"slug":9,"createdAt":10,"updatedAt":11,"publishedAt":12,"backDate":13,"documentId":14,"imageUrl":15,"seo":61,"expertises":135,"author":341,"blocks":447},743,"Non-human identity-risico begint in de architectuur","In de eerste twee blogs* van deze reeks stond de blinde vlek rond non-human identities centraal: veel Zero Trust-ontwerpen zijn nog steeds gericht op mensen, terwijl cloudomgevingen juist draaien op workloads, pipelines en services. Maar waar ontstaat dat risico precies? Niet pas bij beheer of controle. Het begint al in de architectuur.\n\nCloud- en AI-architecturen zijn ontworpen voor snelheid, schaal en automatisering. Precies die kwaliteiten zorgen ervoor dat technische identiteiten sneller ontstaan dan organisaties ze kunnen overzien. Dit is een bestuurlijk risico: architectuur bepaalt wie of wat toegang krijgt, hoe ver dat vertrouwen reikt en hoelang het blijft bestaan.\n\nIn deze derde blog lees je hoe dat patroon ontstaat, waar het zichtbaar wordt en welke signalen erop wijzen dat identiteitsrisico structureel in de architectuur is ingebouwd.","non-human-identity-risico-begint-in-de-architectuur","2026-08-24T15:08:45.219Z","2026-08-25T12:48:38.429Z","2026-08-25T12:48:38.780Z","2026-08-24","u27f5d2lvu8sn6i17t4hvcw0",{"id":16,"name":17,"alternativeText":18,"caption":18,"width":19,"height":20,"formats":21,"hash":55,"ext":23,"mime":26,"size":56,"url":57,"previewUrl":18,"provider":58,"provider_metadata":18,"createdAt":59,"updatedAt":59,"documentId":60,"publishedAt":59,"focalPoint":18},1503,"Blog hoofdafbeelding.jpg",null,1280,500,{"large":22,"small":32,"medium":39,"thumbnail":47},{"ext":23,"url":24,"hash":25,"mime":26,"name":27,"path":18,"size":28,"width":29,"height":30,"sizeInBytes":31},".webp","https://incredible-beef-2a6059b946.media.strapiapp.com/large_Blog_hoofdafbeelding_d8b41044ed.webp","large_Blog_hoofdafbe