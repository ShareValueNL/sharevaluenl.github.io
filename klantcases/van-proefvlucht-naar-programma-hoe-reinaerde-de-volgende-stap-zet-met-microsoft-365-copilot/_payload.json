_microsoft development.jpg",212.98,{"ext":250,"url":367,"hash":368,"mime":253,"name":369,"path":13,"size":370,"width":20,"height":262},"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Fsmall_microsoft_development_0466304f1a.jpg","small_microsoft_development_0466304f1a","small_microsoft development.jpg",82.36,{"ext":250,"url":372,"hash":373,"mime":253,"name":374,"path":13,"size":375,"width":44,"height":268},"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Fmedium_microsoft_development_0466304f1a.jpg","medium_microsoft_development_0466304f1a","medium_microsoft development.jpg",145.39,{"ext":250,"url":377,"hash":378,"mime":253,"name":379,"path":13,"size":380,"width":274,"height":275},"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Fthumbnail_microsoft_development_0466304f1a.jpg","thumbnail_microsoft_development_0466304f1a","thumbnail_microsoft development.jpg",19.5,"microsoft_development_0466304f1a",303.17,"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Fmicrosoft_development_0466304f1a.jpg","2024-08-08T09:53:15.803Z","ryasrsii36mo66jfb0jpir09",{"id":387,"title":388,"subTitle":389,"content":390,"callToActionText":391,"callToActionLink":210,"colorStyle":243,"showAsides":72,"imageUrl":392,"__component":281},30,"Migratie","Migreer je documenten veilig","Steeds meer bedrijven migreren hun data naar Microsoft 365. Het begeleiden van dit proces en het maken van de juiste beslissingen is cruciaal voor een succesvolle migratie. Onze consultants hebben ervaring met datamigratie naar Microsoft 365 en kunnen ook jouw medewerkers trainen om optimaal met deze verandering om te gaan.","Kunnen wij je helpen met je migratie?",{"id":393,"name":394,"alternativeText":13,"caption":13,"width":19,"height":247,"formats":395,"hash":416,"ext":250,"mime":253,"size":417,"url":418,"previewUrl":13,"provider":58,"provider_metadata":13,"createdAt":419,"updatedAt":419,"documentId":420,"publishedAt":181,"focalPoint":