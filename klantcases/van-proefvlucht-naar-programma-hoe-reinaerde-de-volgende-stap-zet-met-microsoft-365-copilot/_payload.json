etadata":13,"createdAt":453,"updatedAt":453,"documentId":454,"publishedAt":181,"focalPoint":13},787,"microsoft security.jpg",{"large":430,"small":435,"medium":440,"thumbnail":445},{"ext":250,"url":431,"hash":432,"mime":253,"name":433,"path":13,"size":434,"width":29,"height":256},"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Flarge_microsoft_security_32a9b008d7.jpg","large_microsoft_security_32a9b008d7","large_microsoft security.jpg",164.98,{"ext":250,"url":436,"hash":437,"mime":253,"name":438,"path":13,"size":439,"width":20,"height":262},"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Fsmall_microsoft_security_32a9b008d7.jpg","small_microsoft_security_32a9b008d7","small_microsoft security.jpg",42.07,{"ext":250,"url":441,"hash":442,"mime":253,"name":443,"path":13,"size":444,"width":44,"height":268},"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Fmedium_microsoft_security_32a9b008d7.jpg","medium_microsoft_security_32a9b008d7","medium_microsoft security.jpg",95.92,{"ext":250,"url":446,"hash":447,"mime":253,"name":448,"path":13,"size":449,"width":274,"height":275},"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Fthumbnail_microsoft_security_32a9b008d7.jpg","thumbnail_microsoft_security_32a9b008d7","thumbnail_microsoft security.jpg",9,"microsoft_security_32a9b008d7",254.11,"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Fmicrosoft_security_32a9b008d7.jpg","2024-08-08T09:59:12.203Z","s7y4pqdrz66q79moz4tdfnpj",{"id":456,"title":457,"subTitle":458,"content":459,"callToActionText":460,"callToActionLink":461,"colorStyle":243,"showAsides":72,"imageUrl":462,"__component":281},32,"Teams Store","Optimaliseer je hardware","Teams Store, onderdeel van ShareValue, biedt onze klanten kennis en expertise op het gebied van audiovisuele communicatie. Of je nu een kleine vergaderruimte wilt uitrusten met een professionele microfoon of een compleet auditorium wilt voorzien van de nieuwste projectietechnologie, Teams Store heeft de oplossing. Wij zijn meer dan alleen een leverancier; we zijn de kennispartner die van A tot Z ontzorgt.\n\nWat kun je van Teams Store verwachten?\n- **Deskundig advies**: onze ervaren adviseurs helpen je graag bij het kiezen van de juiste apparatuur en het ontwerpen van een systeem dat perfect aansluit bij de wensen en het budget van jouw organisatie.\n- **Installatie en onderhoud**: wij zorgen voor de professionele installatie van de apparatuur en bieden uitgebreide onderhoudscontracten om jouw investering te beschermen.\n- **Training en ondersteuning**: onze ShareValue IT-experts geven trainingen aan jouw medewerkers om ze te leren omgaan met de nieuwe apparatuur. Je kunt ook altijd bij ons terecht voor ondersteuning en service.","Bekijk de website van Teams Store","https:\u002F\u002Fteamsstore.nl\u002F",{"id":463,"name":464,"alternativeText":13,"caption":13,"width":19,"height":247,"formats":465,"hash":486,"ext":250,"mime":253,"size":487,"url":488,"previewUrl":13,"provider":58,"provider_metadata":13,"createdAt":489,"updatedAt":489,"documentId":490,"publishedAt":181,"focalPoint":13},788,"vergaderruimte.jpg",{"large":466,"small":471,"medium":476,"thumbnail":481},{"ext":250,"url":467,"hash":468,"mime":253,"name":469,"path":13,"size":470,"width":29,"height":256},"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Flarge_vergaderruimte_cdd4afc99d.jpg","large_vergaderruimte_cdd4afc99d","large_vergaderruimte.jpg",82.12,{"ext":250,"url":472,"hash":473,"mime":253,"name":474,"path":13,"size":475,"width":20,"height":262},"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Fsmall_vergaderruimte_cdd4afc99d.jpg","small_vergaderruimte_cdd4afc99d","small_vergaderruimte.jpg",29.05,{"ext":250,"url":477,"hash":478,"mime":253,"name":479,"path":13,"size":480,"width":44,"height":268},"https:\u002F\u002Fincredible-beef-2a6059b946.media.strapiapp.com\u002Fmedium_vergaderruimte_cdd4afc99d.jpg","mediu